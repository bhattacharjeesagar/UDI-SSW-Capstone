<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Issuer Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f9;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }
        .wrapper {
            display: flex;
            align-items: stretch;
            width: 100vw;
            height: 100vh;
        }
        /* Sidebar styling (AdminLTE style) */
        .sidebar {
            min-width: 250px;
            max-width: 250px;
            background-color: #343a40;
            color: #fff;
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
        }
        .sidebar-header {
            padding: 20px;
            background-color: #22252a;
            text-align: center;
            border-bottom: 1px solid #4b545c;
        }
        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
        }
        .sidebar-menu li a {
            padding: 12px 20px;
            display: block;
            color: #c2c7d0;
            text-decoration: none;
            border-left: 3px solid transparent;
            font-size: 0.9rem;
        }
        .sidebar-menu li a:hover {
            background-color: rgba(255, 255, 255, 0.1);
            color: #fff;
        }
        .sidebar-menu li.active a {
            background-color: #007bff;
            color: #fff;
            border-left-color: #007bff;
        }
        .sidebar-menu li a i {
            margin-right: 10px;
        }
        .sidebar-user {
            padding: 15px;
            border-top: 1px solid #4b545c;
            background-color: #22252a;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #ffc107;
            color: #212529;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }
        /* Content area styling */
        .content-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }
        .top-navbar {
            background-color: #fff;
            padding: 15px 30px;
            border-bottom: 1px solid #dee2e6;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
        }
        .main-content {
            padding: 30px;
            flex-grow: 1;
        }
        .card {
            border: none;
            border-radius: 6px;
            box-shadow: 0 0 1px rgba(0,0,0,.125), 0 1px 3px rgba(0,0,0,.2);
            margin-bottom: 20px;
        }
        .card-header {
            background-color: #fff;
            border-bottom: 1px solid rgba(0,0,0,.125);
            font-weight: 600;
        }
        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
        }
        .pem-block {
            font-family: monospace;
            font-size: 0.75rem;
            white-space: pre-wrap;
            background-color: #212529;
            color: #f8f9fa;
            padding: 15px;
            border-radius: 4px;
            max-height: 150px;
            overflow-y: auto;
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <h5>🏦 Govt Issuer</h5>
            </div>
            <ul class="sidebar-menu">
                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <a asp-controller="Issuer" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Registries" ? "active" : "")">
                    <a asp-controller="Issuer" asp-action="Registries">
                        <i class="bi bi-shield-lock"></i> Registries & Keys
                    </a>
                </li>
            </ul>
            <div class="sidebar-user">
                <div class="user-avatar">I</div>
                <div>
                    <div class="small text-white">@User.FindFirst("FullName")?.Value</div>
                    <div class="small text-muted" style="font-size: 0.75rem;">Issuer Portal</div>
                </div>
            </div>
        </nav>

        <!-- Content Area -->
        <div class="content-wrapper">
            <!-- Top Navbar -->
            <header class="top-navbar">
                <div>
                    <span class="navbar-brand text-dark font-weight-bold">Govt Identity Office Portal</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted font-weight-bold" style="font-size: 0.95rem;">UDI - SSW Capstone Portal</span>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-box-arrow-right"></i> Sign Out
                    </a>
                </div>
            </header>

            <!-- Main Content -->
            <main class="main-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>Success:</strong> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error:</strong> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
