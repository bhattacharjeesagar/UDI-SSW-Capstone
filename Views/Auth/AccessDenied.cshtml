@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card p-5 shadow border-0">
            <div class="text-danger mb-4">
                <i class="bi bi-shield-slash-fill" style="font-size: 4rem;"></i>
            </div>
            <h2 class="text-dark font-weight-bold">Access Denied</h2>
            <p class="text-muted lead mt-2">You do not have permissions to access this page.</p>
            <p class="small text-muted mb-4">Your current authenticated role is not authorized for this specific portal.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/" class="btn btn-primary">Go to Home Overview</a>
                <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger">Sign Out</a>
            </div>
        </div>
    </div>
</div>
